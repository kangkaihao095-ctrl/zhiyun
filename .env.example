# Copy to .env or export before `mvn spring-boot:run`

ZHIYUN_LLM_MODE=auto
SILICONFLOW_API_KEY=
ZHIYUN_LLM_BASE_URL=https://api.siliconflow.cn/v1
ZHIYUN_PAPER_MODEL=deepseek-ai/DeepSeek-V3.2
ZHIYUN_CS_MODEL=deepseek-ai/DeepSeek-V4-Flash
ZHIYUN_VISION_MODEL=deepseek-ai/deepseek-vl2
ZHIYUN_CS_RUNTIME=dify
DIFY_API_URL=
DIFY_API_KEY=
# 仅本机。非本机必须改 JWT_SECRET；prod 拒绝仓库默认值。MCP 不要把 dev-mcp-token 带到可对外环境。
ZHIYUN_MCP_TOKEN=dev-mcp-token
JWT_SECRET=change-me-in-prod-please-32chars!!
# 默认已同时放行 127.0.0.1 与 localhost；不要写 *
# ZHIYUN_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# ZHIYUN_EVAL_API=true
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/zhiyun?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=utf8
MYSQL_USER=zhiyun
MYSQL_PASSWORD=zhiyun
